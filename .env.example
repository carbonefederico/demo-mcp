# Server
PORT=3000

# Host/origin allowlist (comma-separated, leave empty to allow all)
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# OAuth / JWT protection
OAUTH_ENABLED=false
# Issuer advertised in the protected-resource metadata (falls back to deriving it from the first JWKS_URI entry)
OAUTH_ISSUER=https://auth.example.com
# One or more JWKS endpoints, comma-separated; tokens are tried against each until one verifies
JWKS_URI=https://auth.example.com/.well-known/jwks.json
JWT_AUDIENCE=https://api.example.com
